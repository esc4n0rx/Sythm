# Copie para apps/backend/.env (ignorado pelo git) e ajuste.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Postgres (qualquer provedor: local via docker compose, pgx.dev, Neon, Supabase, RDS...)
DATABASE_URL=postgres://sythm:sythm@localhost:5432/sythm
# Defina true se o provedor exigir TLS (a maioria dos serviços gerenciados exige)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# OBRIGATÓRIO em produção (>= 32 caracteres). Gere com: openssl rand -base64url 48
# Em desenvolvimento, se vazio, um segredo efêmero é gerado a cada start.
SYTHM_AUTH_SECRET=

# Validade do token em horas (padrão 168 = 7 dias). O frontend renova via /api/auth/refresh.
SYTHM_TOKEN_TTL_HOURS=168

# Origens permitidas por CORS, separadas por vírgula.
# Em produção, vazio = bloqueia requisições cross-origin (use quando frontend e API compartilham domínio/proxy).
CORS_ORIGINS=

# true quando atrás de proxy reverso/load balancer (para o rate limit enxergar o IP real)
TRUST_PROXY=false

RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
