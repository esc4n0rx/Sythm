{
  "name": "@sythm/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Compiler, lexer, parser and timeline planner for the Sythm live-coding music language",
  "keywords": [
    "sythm",
    "live-coding",
    "cobol",
    "web-audio",
    "synthesizer",
    "music-dsl",
    "strudel",
    "euclidean-rhythms",
    "dsp",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
